independent of the trivial σ-algebra. -/
theorem fep009_condIndep_bot_right
    (m' m₁ : MeasurableSpace Ω) (hm' : m' ≤ mΩ)
    (μ : @Measure Ω mΩ) [IsFiniteMeasure μ] :
